go-module_set_globals
SRC_URI+="${EGO_SUM_SRC_URI}"

DEPEND="acct-group/loki
		acct-user/loki
		dev-vcs/git"

LICENSE="AGPL-3"
SLOT="0"
KEYWORDS="~amd64 ~arm ~arm64 ~ppc64 ~riscv ~x86"


src_compile() {
	export GOMAXPROCS=$(makeopts_jobs "${MAKEOPTS}" "$(get_nproc)")

	git config --global init.defaultBranch main || die
	git config --global user.email "you@example.com" || die
    git config --global user.name "Your Name" || die
	git init || die
    git add . || die
    git commit -m 'init' || die

	go-env_set_compile_environment
	#local GOFLAGS="${GOFLAGS} -tags=linux,promtail_journal_enabled -p=$(makeopts_jobs)"
	emake promtail logcli loki UNAME_S="Linux"
}
src_install() {
	dobin cmd/loki/loki
	dobin clients/cmd/promtail/promtail
	dobin cmd/logcli/logcli

	insinto /etc/${PN}
	newins examples/getting-started/loki-config.yaml loki.yaml
	newins clients/cmd/promtail/promtail-local-config.yaml promtail.yaml

	newinitd "${FILESDIR}/loki.initd" loki
	newinitd "${FILESDIR}/promtail.initd" promtail
	newconfd "${FILESDIR}/loki.confd" loki

	dodir /var/lib/loki
	fowners loki:loki /var/lib/loki
	keepdir /var/lib/loki
}
